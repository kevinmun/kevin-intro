---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Articles — Kevin Mun" description="Articles and write-ups by Kevin Mun.">
  <section class="articles-page">
    <h1>Articles</h1>
    <p class="subtitle">Thoughts, tutorials, and things I've learned along the way.</p>

    {articles.length === 0 ? (
      <p class="empty">No articles yet — check back soon.</p>
    ) : (
      <ul class="article-list">
        {articles.map((article) => (
          <li>
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              date={article.data.date}
              href={`${base}articles/${article.id}/`}
              tags={article.data.tags}
            />
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .articles-page {
    padding-block: var(--space-xl);
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .article-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
</style>
